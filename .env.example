# Live test creds (provided by user; not committed)
NAPOLEON_EMAIL=your-email@example.com
NAPOLEON_PASSWORD=your-password

# Optional. Leave unset to auto-discover via the Ayla device list.
# Only needed if your account has more than one Napoleon fireplace
# and you want to target a specific one.
# NAPOLEON_DSN=AC000W032261383

# Optional. Override the default Ayla app id/secret bundled in
# pynapoleon/const.py. Almost no one needs these.
# NAPOLEON_APP_ID=
# NAPOLEON_APP_SECRET=
